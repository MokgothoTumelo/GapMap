{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gapmap.app/schema/assessment-item.schema.json",
  "title": "GapMap Assessment Item",
  "type": "object",
  "required": ["id", "concept", "prompt", "prompt_type", "correct"],
  "properties": {
    "id": { "type": "string", "pattern": "^q[0-9]+$" },
    "concept": { "type": "string" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "prompt": { "type": "string" },
    "prompt_type": { "enum": ["multiple_choice", "short_answer", "numeric"] },
    "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "correct": { "type": ["integer", "number", "string"] },
    "correct_explanation": { "type": "string" },
    "wrong_explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["answer", "explanation"],
        "properties": {
          "answer": { "type": ["integer", "number", "string"] },
          "explanation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "prompt_type": { "const": "multiple_choice" } }, "required": ["prompt_type"] },
      "then": { "required": ["options"], "properties": { "correct": { "type": "integer", "minimum": 0 } } }
    }
  ],
  "additionalProperties": false
}
