{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gapmap.app/schema/retest.schema.json",
  "title": "GapMap Retest Assessment",
  "allOf": [
    { "$ref": "assessment-common.schema.json" },
    {
      "type": "object",
      "required": ["target"],
      "properties": {
        "type": { "const": "retest" },
        "concepts": { "minItems": 1, "maxItems": 1 },
        "items": { "minItems": 3, "maxItems": 5 },
        "target": {
          "type": "object",
          "required": ["concept"],
          "properties": {
            "concept": { "type": "string" },
            "previous_attempt_id": { "type": "string" },
            "previous_score": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
