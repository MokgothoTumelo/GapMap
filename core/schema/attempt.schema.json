{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gapmap.app/schema/attempt.schema.json",
  "title": "GapMap Assessment Attempt",
  "description": "App-written record of a learner's responses to an assessment, with derived per-concept scores.",
  "type": "object",
  "required": ["id", "assessment_id", "learner_id", "started_at", "responses", "scores"],
  "properties": {
    "id": { "type": "string" },
    "assessment_id": { "type": "string" },
    "learner_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/$defs/response" }
    },
    "scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept_score" }
    },
    "overall_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "next_concept": { "type": "string", "description": "recommended concept to study next" }
  },
  "$defs": {
    "response": {
      "type": "object",
      "required": ["item_id", "answer", "correct"],
      "properties": {
        "item_id": { "type": "string" },
        "answer": true,
        "correct": { "type": "boolean" },
        "time_ms": { "type": "integer", "minimum": 0 },
        "feedback": { "type": "string", "description": "generated 'why did I get this wrong' for incorrect responses" }
      }
    },
    "concept_score": {
      "type": "object",
      "required": ["concept", "correct", "total", "pct", "status"],
      "properties": {
        "concept": { "type": "string" },
        "correct": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["strong", "improve", "weak"] }
      }
    }
  }
}